        "type": "string"
      },
      "watchlist_limit": {
        "default": 5,
        "description": "每位用户最多可保存的自选股数量，默认 5 只，范围 1-50。",
        "maximum": 50,
        "minimum": 1,
        "single_line": true,
        "title": "自选股数量上限",
